\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)  }{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select the variable to be displayed on the vertical (Y) axis from the Y Variable list box and the }
\ql{\f0\fs24\cf0\up0\dn0 variable to be displayed on the horizontal (X) axis from the X Variable list box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the XY button}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Repeat to view a different variables.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Animated_XY}
${\footnote Animated XY Graphs}
K{\footnote Animated XY Graphs}
+{\footnote Browse:0015}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Animated XY Graphs}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0  To view how the relationship between two variables changes over time:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)  }{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select the variable to be displayed on the vertical (Y) axis from the Y Variable list box and the }
\ql{\f0\fs24\cf0\up0\dn0 variable to be displayed on the horizontal (X) axis from the X Variable list box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the XY Animate button.  The Animation Control dialog box will appear.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Adjust the Speed arrow and determine how many points to display in the Number of Points To }
\ql{\f0\fs24\cf0\up0\dn0 Display box.  It is recommended to run the animation at the fastest speed the first time.  Then , if necessary, }
\ql{\f0\fs24\cf0\up0\dn0 slow it down a little at a time.  An animation cannot be stopped after it starts.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 4)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Set the Clear Screen button.  If this box contains an "X", then all graphs contained in the Graph }
\ql{\f0\fs24\cf0\up0\dn0 Window will be cleared.  If you would like to animate around an object currently contained in the Graph }
\ql{\f0\fs24\cf0\up0\dn0 Window, such as a model line, then click on the Clear Screen button until that box is blank.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 5)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the Begin button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 6)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the Quit button to remove the Animation Control dialog box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Histograms}
${\footnote Histograms}
K{\footnote Histograms}
+{\footnote Browse:0020}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Histograms}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Histograms display a channel's frequency and probability distributions.  To create a histogram plot:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Note a channel's maximum and minimum values by viewing a time-series plot of the channel. }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Make sure the channel is still selected in the Y Variable list box and then click the Histogram button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 In the Histogram dialog box (Figure 6.2), enter approximate maximum and minimum values for the }
\ql{\f0\fs24\cf0\up0\dn0 channel and select the number of intervals into which the data range (Ymax - Ymin) will be divided.  Click }
\ql{\f0\fs24\cf0\up0\dn0 OK.  For example, if a the values of a channel ranged 9 to 183, you may want to choose Ymin = 0, Ymax = }
\ql{\f0\fs24\cf0\up0\dn0 200 and Num Intervals = 10 to create 10 intervals of width 20.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0   }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 In the histogram that is displayed, the frequency of occurrence in each interval is shown on the left-hand }
\ql{\f0\fs24\cf0\up0\dn0 side of the graph.  The probability of a value appearing in an interval is plotted along the right-hand side of }
\ql{\f0\fs24\cf0\up0\dn0 the graph.  If the G1|G2 button is selected then the probabilities will be shown along the right-hand side of }
\ql{\f0\fs24\cf0\up0\dn0 the plot as Group One probability, followed by a slash, followed by Group Two probability.  The Group One }
\ql{\f0\fs24\cf0\up0\dn0 graph will appear on the left-hand side of the Graph Window and the Group Two graph will appear on the }
\ql{\f0\fs24\cf0\up0\dn0 right-hand side of the Graph Window.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0      The number and frequency of observations in each data interval are described in the Value Window.  }
\ql{\f0\fs24\cf0\up0\dn0 The values in each parenthesis are: 1) the interval number, 2) the number of observations in the interval, }
\ql{\f0\fs24\cf0\up0\dn0 and 3) the frequency of observations in the interval.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Value_Identification}
${\footnote Value Identification}
K{\footnote Value Identification}
+{\footnote Browse:0025}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Value Identification}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The value and time of any data point displayed on a graph can be identified by clicking on the point with the }
\ql{\f0\fs24\cf0\up0\dn0 mouse.  The value and time of that point will be displayed in the Value Window.  The cursor, which is }
\ql{\f0\fs24\cf0\up0\dn0 displayed as a large square data point, will be set to the selected point.  When multiple points lie on top of }
\ql{\f0\fs24\cf0\up0\dn0 each other, the values and times of all of the points will be displayed and the cursor will be set to the last }
\ql{\f0\fs24\cf0\up0\dn0 point.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Data values can be displayed sequentially by pushing the forward arrow or backward arrow on the }
\ql{\f0\fs24\cf0\up0\dn0 keyboard.  This advances the cursor to the next or previous data point in time.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Grid_Lines}
${\footnote Grid Lines}
K{\footnote Grid Lines}
+{\footnote Browse:0030}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Grid Lines}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 A grid of lines corresponding to the X and Y axis labels can be superimposed on any graph.  }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0  To display a grid:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select Graphics, Grid from the menu.  A check mark appears next to the menu item.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Create any graph described above.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To remove a grid:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select Graphics, Grid from the menu.  The check mark next to the menu item disappears.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Create any graph described above.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The grid function remains active as long as the Graphics, Grid menu item remains checked.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Modeling}
${\footnote Modeling}
K{\footnote Modeling}
+{\footnote Browse:0035}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Modeling}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Energy Explorer supports mean, median, simple linear regression, multi-linear change-point regression, }
\ql{\f0\fs24\cf0\up0\dn0 multivariable regression and bin-fit models.  These models were specifically chosen or developed to model }
\ql{\f0\fs24\cf0\up0\dn0 the most common patterns of building and facility energy use.  This chapter describes each type of model }
\ql{\f0\fs24\cf0\up0\dn0 and gives some guidance for their appropriate use.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Because of the general importance of energy use models, we refer to "energy use" throughout this chapter }
\ql{\f0\fs24\cf0\up0\dn0 as the dependent, y, value for each model.  However, the Energy Explorer models are generic and can be }
\ql{\f0\fs24\cf0\up0\dn0 used to determine correlations between any type of variables.    }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Energy Explorer regression models are named according to the number of regression pararameters, P, in }
\ql{\f0\fs24\cf0\up0\dn0 the model.  For example, the 2P model is a simple linear regression model in the form:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Y = b1 + b2 X}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 specified by a y-intercept b1 and a slope b2.  3P, 4P and 5P models require 3, 4 and 5 regression }
\ql{\f0\fs24\cf0\up0\dn0 coefficients, respectively.  3P, 4P and 5P models are called change-point models because the model }
\ql{\f0\fs24\cf0\up0\dn0 consists of two or more linear line segments joined by a change point.  Change-point models are }
\ql{\f0\fs24\cf0\up0\dn0 appropriate for modeling energy use that is non-linearly correlated with an independent variable. }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Frequently, energy use is influenced by more than one independent variable.  For these cases, Enertel }
\ql{\f0\fs24\cf0\up0\dn0 Analysis supports multiple-variable (MVR) forms of the basic 2P, 3P, 4P and 5P models.  The Bin Fit model }
\ql{\f0\fs24\cf0\up0\dn0 is useful for modeling highly non-linear energy use.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Running a Model}{\v Hlp_Running_a}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Mean and Median Models}{\v Hlp_Mean_and} }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb 2P and 2P+MVR Models}{\v Hlp_2P_and}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb 3P and 3P+MVR Models}{\v Hlp_3P_and}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb 4P and 4P+MVR Models}{\v Hlp_4P_and}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb 5P and 5P+MVR Models}{\v Hlp_5P_and}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Bin Fit Models}{\v Hlp_Bin_Fit}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Modeling Groups}{\v Hlp_Modeling_Groups}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Prediction Intervals}{\v Hlp_Prediction_Intervals}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Residual Analysis}{\v Hlp_Residual_Analysis}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Model Parameters and Statistics}{\v Hlp_Model_Parameters}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Mean_and}
${\footnote Mean and Median Models}
K{\footnote Mean and Median Models}
+{\footnote Browse:0040}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Mean and Median Models}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 When energy use is not correlated with other variables, use a mean or median model to quantitatively }
\ql{\f0\fs24\cf0\up0\dn0 describe the "center" of the energy use data.  The mean model is calculated as the sum of all y values }
\ql{\f0\fs24\cf0\up0\dn0 divided by the number of y values in the sum.  The median value is determined such that there are equal }
\ql{\f0\fs24\cf0\up0\dn0 numbers of values that are greater and less than the median.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_2P_and}
${\footnote 2P and 2P+MVR Models}
K{\footnote 2P and 2P+MVR Models}
+{\footnote Browse:0045}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 2P and 2P+MVR Models}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 When energy use appears to be linearly correlated with a single variable, use a 2P model. The 2P model is }
\ql{\f0\fs24\cf0\up0\dn0 a simple linear regression model of the form:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Y = b1 + b2 X1}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where b1 and b2 are regression coefficients, X1 is the independent variable and Y is the dependent }
\ql{\f0\fs24\cf0\up0\dn0 variable.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 2P+MVR}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 When energy use is influenced by more than one independent variable, you can create a multivariable }
\ql{\f0\fs24\cf0\up0\dn0 regression (MVR) model by clicking on the M button next to the 2P button.  2P+MVR models can have up to }
\ql{\f0\fs24\cf0\up0\dn0 six independent variables, and are of the form:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Y  =  b1  +  b2 X1  +  b3 X2  +  b4 X3 +  b5 X4  +  b6 X5  +  b7 X6}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where b1 through b7 are regression coefficients, and X1 through X6 are optional independent variables.  In }
\ql{\f0\fs24\cf0\up0\dn0 a 2P+MVR model, all independent variables are modeled as being linearly related to the dependent Y }
\ql{\f0\fs24\cf0\up0\dn0 variable.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_3P_and}
${\footnote 3P and 3P+MVR Models}
K{\footnote 3P and 3P+MVR Models}
+{\footnote Browse:0050}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 3P and 3P+MVR Models}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 When energy use appears to be linearly correlated with an independent variable over part of the }
\ql{\f0\fs24\cf0\up0\dn0 independent variable's range and uncorrelated over the other part, use a 3P model.  There are two forms of }
\ql{\f0\fs24\cf0\up0\dn0 the 3P model, 3PC and 3PH.  The "C"  and "H" refer to cooling and heating.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3PC models are often useful for modeling electricity use versus outdoor air temperature in residences with }
\ql{\f0\fs24\cf0\up0\dn0 an air conditioner.  During colder winter temperatures, electricity use is uncorrelated with temperature and }
\ql{\f0\fs24\cf0\up0\dn0 appears to be rather flat on a electricity use versus outdoor air temperature plot.  During warmer summer }
\ql{\f0\fs24\cf0\up0\dn0 months, electricity use usually increases with outdoor air temperature.  In these cases, a 3PC model of }
\ql{\f0\fs24\cf0\up0\dn0 electricity use versus outdoor air temperature will typically provide a good fit to the data.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Similarly, 3PH models are often useful for modeling residential natural gas or heating oil use.  During colder }
\ql{\f0\fs24\cf0\up0\dn0 winter temperatures, gas or oil use typically increases as the temperature declines. During warmer summer }
\ql{\f0\fs24\cf0\up0\dn0 months when the furnace is off, gas or oil use typically remains relatively constant for domestic hot water }
\ql{\f0\fs24\cf0\up0\dn0 and cooking purposes.  In these cases, a 3PH model of gas or oil use versus outdoor air temperature will }
\ql{\f0\fs24\cf0\up0\dn0 typically provide a good fit to the data.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3PC and 3PH models are of the form:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 YC  =  b1  +  b2 ( X1 - b3 )+}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 YH  =  b1  +  b2 ( X1 - b3 )-}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where b1 is the y- coordinate of the change point, b2 is the slope term, and b3 is the x-coordinate of the }
\ql{\f0\fs24\cf0\up0\dn0 change-point,.  The ( )+ and ( )- notations indicate that the values of the parenthetic term shall be set to zero }
\ql{\f0\fs24\cf0\up0\dn0 when they are negative and positive respectively.  }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 3P+MVR}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0  When the 3P model gives a good fit to the data, but energy use may be influenced by more than one }
\ql{\f0\fs24\cf0\up0\dn0 independent variable, you can create a 3P+MVR model by clicking on the M button next to the 3PC or 3PH  }
\ql{\f0\fs24\cf0\up0\dn0 buttons.  3P+MVR models can have up to four independent variables, and are of the form:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 YC  =  b1  +  b2 ( X1 - b3 )+ +  b4 X2 +  b5 X3  +  b6 X4}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 YH  =  b1  +  b2 ( X1 - b3 )- +  b4 X2 +  b5 X3  +  b6 X4}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where b4 through b6 are regression coefficients of the optional independent variables X2 through X4.  In a }
\ql{\f0\fs24\cf0\up0\dn0 3P+MVR model, the first independent variable X1 is modeled with the 3P change-point and the additional }
\ql{\f0\fs24\cf0\up0\dn0 independent variables are modeled as being linearly related to the dependent Y variable.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 3P Model Algorithm}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Energy Explorer constructs three parameter change-point models using a search routine combined with an }
\ql{\f0\fs24\cf0\up0\dn0 indicator variable regression technique.  The form of the regression equation is:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 y = a + b (I  (x - xcp))}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where y is the dependent variable, x is the independent variable, a and b are parameters determined by }
\ql{\f0\fs24\cf0\up0\dn0 regression, I is an indicator variable and xcp is the x change-point.  I is set to 0 or 1 according to the }
\ql{\f0\fs24\cf0\up0\dn0 following rule:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 For 3P-CP-C:}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 I = 0 when x <= xcp}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 I = 1 when x > xcp}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 For 3P-CP-H:}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 I = 1 when x <= xcp}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 I = 0 when x > xcp}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To identify the x change-point, Energy Explorer utilizes a two-pass search routine.  On the first pass it }
\ql{\f0\fs24\cf0\up0\dn0 divides the entire x interval (xmax - xmin) into ten equal sub-intervals.  It then sets each sub-interval }
\ql{\f0\fs24\cf0\up0\dn0 boundary equal to x change-point, performs the above regression, and stores the x change-point value and }
\ql{\f0\fs24\cf0\up0\dn0 sum of squared error for the regression. Energy Explorer then selects the x change-point value that yielded }
\ql{\f0\fs24\cf0\up0\dn0 the lowest sum of squared error as the best x change-point on the first pass.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 On the second pass, Energy Explorer divides an interval from one sub-interval to the left and one sub-}
\ql{\f0\fs24\cf0\up0\dn0 interval to the right of the best x change-point into ten new sub-intervals.  In the case that the best x change-}
\ql{\f0\fs24\cf0\up0\dn0 point value lies at one of the end points of the original x interval, only the adjacent sub-interval is re-divided }
\ql{\f0\fs24\cf0\up0\dn0 into ten new sub-intervals.  The search is then repeated as before and Energy Explorer selects the x }
\ql{\f0\fs24\cf0\up0\dn0 change-point that yielded the lowest sum of squared error. }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Energy Explorer reports the standard error of the y change-point as the standard error of the parameter a }
\ql{\f0\fs24\cf0\up0\dn0 and the standard error of the slope as the standard error of the parameter b.  The standard error of the x-}
\ql{\f0\fs24\cf0\up0\dn0 coordinate of the change point is reported as the width of the smallest x-interval in the search procedure to }
\ql{\f0\fs24\cf0\up0\dn0 locate the best-fit model.}{
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_4P_and}
${\footnote 4P and 4P+MVR Models}
K{\footnote 4P and 4P+MVR Models}
+{\footnote Browse:0055}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 4P and 4P+MVR Models}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The 4P model consists of two linear segments joined at a change-point.  When energy use appears to be }
\ql{\f0\fs24\cf0\up0\dn0 non-linearly correlated with an independent variable, a 4P model may provide a good fit to the data.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 4P models fit a wide variety of energy use patterns including commercial heating and cooling energy use }
\ql{\f0\fs24\cf0\up0\dn0 versus outside air temperature.  In some cases the change-point may have a physically identifiable }
\ql{\f0\fs24\cf0\up0\dn0 meaning, such as the dew-point temperature of air passing over a cooling coil or a set-point temperature in }
\ql{\f0\fs24\cf0\up0\dn0 a variable-air-volume HVAC system (Kissock et. al., 1999).  }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 4P models are of the form:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Y  =  b1  +  b2 (X1 - b4 )-  +  b3 (X1 - b4 )+}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where b1 is the y-coordinate of the change point, b2  is the left slope, b3 is the right slope and b4 is the x-}
\ql{\f0\fs24\cf0\up0\dn0 coordinate of the change point.  The ( )+ and ( )- notations indicate that the values of the parenthetic term }
\ql{\f0\fs24\cf0\up0\dn0 shall be set to zero when they are negative and positive respectively.  }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 4P+MVR}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 When the 4P model gives a good fit to the data, but energy use may be influenced by more than one }
\ql{\f0\fs24\cf0\up0\dn0 independent variable, you can create a 4P+MVR model by clicking on the M button next to the 4P  button.  }
\ql{\f0\fs24\cf0\up0\dn0 4P+MVR models can have up to three independent variables, and are of the form:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Y  =  b1  +  b2 (X1 - b4)-  +  b3 ( X1 - b4 )+  +  b5 X2  +  b6 X3}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where b5 and b6 are regression coefficients of the optional independent variables X2 and X3.  In a 4P+MVR }
\ql{\f0\fs24\cf0\up0\dn0 model, the first independent variable X1 is modeled as a 4P change-point model, and the additional }
\ql{\f0\fs24\cf0\up0\dn0 independent variables are modeled as being linearly related to the dependent Y variable.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 4P Model Algorithm}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The four parameter change-point model algorithm is similar to the three parameter change-point model }
\ql{\f0\fs24\cf0\up0\dn0 algorithm.  The regression equation is:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 y = a   +   b x   +   c I (x - xcp)}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where y is the dependent variable, x is the independent variable, a, b and c are parameters determined by }
\ql{\f0\fs24\cf0\up0\dn0 regression, I is an indicator variable and xcp is the x change-point.  I is set to 0 or 1 according to the }
\ql{\f0\fs24\cf0\up0\dn0 following rule:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 I = 0 when x <= xcp}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 I = 1 when x > xcp}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Energy Explorer then uses the same search routine as was describe for the three parameter change-point }
\ql{\f0\fs24\cf0\up0\dn0 algorithm to determine the x change-point.  The regression equation above then reduces to: }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 y = a   +   b x}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 when x <= xcp}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 y = (a - c xcp)   +   (b + c) x}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 when x > xcp}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Energy Explorer reports the standard error of the y change-point as the standard error of the parameter a, }
\ql{\f0\fs24\cf0\up0\dn0 the standard error of the left slope as the standard error of the parameter b and the standard error of the }
\ql{\f0\fs24\cf0\up0\dn0 right slope as the root sum of squares of the standard errors of b and c.  The standard error of the x-}
\ql{\f0\fs24\cf0\up0\dn0 coordinate of the change point is reported as the width of the smallest x-interval in the search procedure to }
\ql{\f0\fs24\cf0\up0\dn0 locate the best-fit model.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_5P_and}
${\footnote 5P and 5P+MVR Models}
K{\footnote 5P and 5P+MVR Models}
+{\footnote Browse:0060}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 5P and 5P+MVR Models}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0  The 5P model consists of two sloped linear segments connected by a flat linear segment.  The linear }
\ql{\f0\fs24\cf0\up0\dn0 segments are joined at two change-points.  Although, the 5P model can fit a wide variety of data patterns, it }
\ql{\f0\fs24\cf0\up0\dn0 is especially useful when modeling U-shaped data. For example, the pattern of electricity use versus outside }
\ql{\f0\fs24\cf0\up0\dn0 air temperature for a house with an electric heat pump is typically U-shaped.  Electricity use increases }
\ql{\f0\fs24\cf0\up0\dn0 during both the winter and summer as heating and cooling loads increase.  Variable-air-volume fan }
\ql{\f0\fs24\cf0\up0\dn0 electricity use can also show U-shaped behavior when plotted against outside air temperature.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0      5P models are of the form:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Y  =  b1 +  b2 (X1 - b4 )-  +  b3 ( X1 - b5 )+}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where b1 is the y-coordinate of the change points, b2  is the left slope, b3 is the right slope, b4 is the x-}
\ql{\f0\fs24\cf0\up0\dn0 coordinate of the left change point, and b5 is the x-coordinate of the right change point.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 5P+MVR}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 When the 5P model gives a good fit to the data, but energy use may also be influenced by more than one }
\ql{\f0\fs24\cf0\up0\dn0 independent variable, you can create a 5P+MVR model by clicking on the M button next to the 5P  button.  }
\ql{\f0\fs24\cf0\up0\dn0 5P+MVR models can have up to two independent variables, and are of the form:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Y  =  b1 +  b2 ( X1 - b4 )-  +  b3 ( X1 - b5 )+  +  b6 X2  +  b7 X3}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where b6 and b7 are regression coefficients of the optional independent variables X2 and X3.  In a 5P+MVR }
\ql{\f0\fs24\cf0\up0\dn0 model, the first independent variable X1 is modeled as a 5P change-point model, and the additional }
\ql{\f0\fs24\cf0\up0\dn0 independent variables are modeled as being linearly related to the dependent Y variable.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 5P Model Algorithm}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The five parameter change-point model algorithm is similar to the three and four parameter change-point }
\ql{\f0\fs24\cf0\up0\dn0 model algorithms.  The regression equation is:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Y  =  b1   +   b2 (X - Xcp1) I1   +   b3 (X - Xcp2) I2}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where Y is the dependent variable, X is the independent variable, b1, is y intercept of the slope,  b2 is the }
\ql{\f0\fs24\cf0\up0\dn0 left slope, b3 is the right slope, I1 and I2 are indicator variables and Xcp1 and Xcp2 are the left and right }
\ql{\f0\fs24\cf0\up0\dn0 change points respectively.   I1 and I2 are set to 0 or 1 according to the following rules:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 I1 = 1 when X <= Xcp1}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 I1 = 0 when X > Xcp1}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 I2 = 0 when X <= Xcp2}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 I2 = 1 when X > Xcp2}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To identify the x change-points, Energy Explorer utilizes a two-pass search routine.  On the first pass it }
\ql{\f0\fs24\cf0\up0\dn0 divides the entire x interval (X max - X min) into ten equal sub-intervals.  It then finds all possible }
\ql{\f0\fs24\cf0\up0\dn0 combinations of Xcp1 and Xcp2 subject to the constraints that change points are interval boundaries and }
\ql{\f0\fs24\cf0\up0\dn0 Xcp2 > Xcp1.  Next Energy Explorer performs the above regression for each possible combination of }
\ql{\f0\fs24\cf0\up0\dn0 change points, and stores the x change-point values and sum of squared error for each regression. Enertel }
\ql{\f0\fs24\cf0\up0\dn0 Analysis selects the x change-point values that yielded the lowest sum of squared error as the best x }
\ql{\f0\fs24\cf0\up0\dn0 change-points on the first pass.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 On the second pass, Energy Explorer divides an interval from one sub-interval to the left and one sub-}
\ql{\f0\fs24\cf0\up0\dn0 interval to the right of the best Xcp1 and Xcp2 change-points into ten new sub-intervals for each change }
\ql{\f0\fs24\cf0\up0\dn0 point.  It then finds all possible combinations of Xcp1 and Xcp2 change points subject to the constraint that }
\ql{\f0\fs24\cf0\up0\dn0 Xcp2 > Xcp1.  Regressions are performed  as before and Energy Explorer selects the x change-points that }
\ql{\f0\fs24\cf0\up0\dn0 yielded the lowest sum of squared error. }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The regression equation above reduces to: }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Y  =  b1   +   b2 (X - Xcp1)      when X <= Xcp1}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Y  =  b1     when X > Xcp1 and X <= Xcp2}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Y  =  b1  +   b3 (X - Xcp2)    when X > Xcp2}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0  Energy Explorer reports the standard error of the y change-point as the standard error of the parameter b1, }
\ql{\f0\fs24\cf0\up0\dn0 the standard error of the left slope as the standard error of the parameter b2 , the standard error of the right }
\ql{\f0\fs24\cf0\up0\dn0 slope as the standard error of the parameter b23 and the standard errors of the x-coordinates of the change }
\ql{\f0\fs24\cf0\up0\dn0 points as the width of the smallest x-interval in the search procedure.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Bin_Fit}
${\footnote Bin Fit Models}
K{\footnote Bin Fit Models}
+{\footnote Browse:0065}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Bin Fit Models}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The Bin Fit model divides the data into a specified number of  X Variable bins and then calculates the mean }
\ql{\f0\fs24\cf0\up0\dn0 of the Y Variable in each bin.  The number of bins (intervals) is supplied by the user.  After running a Bin Fit }
\ql{\f0\fs24\cf0\up0\dn0 model, the Graph Window displays a line connecting the mean values of each bin.  An ordered pair for each }
\ql{\f0\fs24\cf0\up0\dn0 bin is displayed in the Value Window; each ordered pair describes the midpoint of the bin and the mean of }
\ql{\f0\fs24\cf0\up0\dn0 the values in the bin respectively.}{
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Running_a}
${\footnote Running a Model}
K{\footnote Running a Model}
+{\footnote Browse:0070}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Running a Model}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To find the mean or medial of all values of a variable:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select a variable from the Y Variable list box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select a time series or XY plot of the variable.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click on the Mean or Median buttons.  }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To run a 2P, 3P, 4P , 5P or Bin Fit model:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select the Y and X variables from the Y Variable and X Variable list boxes.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)   Select an XY plot by clicking on the XY graph button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click on the appropriate model button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To run a 2P+MVR, 3P+MVR, 4P+MVR , or 5P+MVR model:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select the Y and X variables from the Y Variable and X Variable list boxes.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select an XY plot by clicking on the XY graph button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click on the M button to the right of the appropriate model button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 4)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 In the Multiple Regression dialog box that appears (Figure 7.2), choose Y from the Regressor box }
\ql{\f0\fs24\cf0\up0\dn0 and select a variable from the Variable Name box to be the dependent (Y) variable.  Click the Set button to }
\ql{\f0\fs24\cf0\up0\dn0 lock in this selection.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Choose X1 from the Regressor box and select a variable from the Variable Name box to be the first }
\ql{\f0\fs24\cf0\up0\dn0 independent (X) variable.  Click the Set button to lock in this selection.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 4)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Repeat step 3 for additional independent (X) variables.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 5)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the OK button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0  To run a bin fit model:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select the Y and X variables from the Y Variable and X Variable list boxes.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click on the Bin Fit button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 In the Bin Fit dialog box that appears (Figure 7.3), choose the number of intervals in which to divide }
\ql{\f0\fs24\cf0\up0\dn0 the data.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 4)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the OK button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Modeling_Groups}
${\footnote Modeling Groups}
K{\footnote Modeling Groups}
+{\footnote Browse:0075}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Modeling Groups}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The active data set can be modeled as a single group or as two individual groups.  To graph and model all }
\ql{\f0\fs24\cf0\up0\dn0 data as a single group, click the Single Group button in the lower right corner of the Energy Explorer work }
\ql{\f0\fs24\cf0\up0\dn0 screen.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To generate a separate model for each of two groups:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Define groups according to the instructions in Grouping Data in Chapter 5.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the G1G2 button in the lower right corner of the Energy Explorer work screen before selecting a }
\ql{\f0\fs24\cf0\up0\dn0 model.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The first model selected will apply to the first group and the second model will apply to the second group.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Prediction_Intervals}
${\footnote Prediction Intervals}
K{\footnote Prediction Intervals}
+{\footnote Browse:0080}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Prediction Intervals}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The 95% prediction intervals for any model can be displayed with the model line.  The prediction interval, PI, }
\ql{\f0\fs24\cf0\up0\dn0 is:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0  PI = t(1-a/2,n-p) * RMSE * (1 + 1/n + X')^.5.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where  a = 0.05, t is the t-statistic evaluated at (1-a/2, n-p), n is the number of observations, p is the number }
\ql{\f0\fs24\cf0\up0\dn0 of parameters in the model and RMSE is the model's root mean square error.  X' is a term proportional to }
\ql{\f0\fs24\cf0\up0\dn0 the distance from the mean value of X; since it is usually small when X is large, it is here assumed to be 0.  }
\ql{\f0\fs24\cf0\up0\dn0 If Y is the value predicted by the model, then the 95% prediction interval is defined such that 95 out of 100 }
\ql{\f0\fs24\cf0\up0\dn0 times, the next measured value of Y will be between Y + PI and Y - PI. }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To display prediction intervals with a model:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select Graphics, Prediction Intervals from the menu. A check mark will appear in front of the menu }
\ql{\f0\fs24\cf0\up0\dn0 item.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Activate a model as described above.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To remove the prediction intervals from a model:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select Graphics, Prediction Intervals from the menu. The check mark will disappear from in front of }
\ql{\f0\fs24\cf0\up0\dn0 the menu item.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Activate a model as described above.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Residual_Analysis}
${\footnote Residual Analysis}
K{\footnote Residual Analysis}
+{\footnote Browse:0085}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Residual Analysis}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 A residual is defined as the difference between a data point and a model's prediction of the data point }
\ql{\f0\fs24\cf0\up0\dn0 (yobserved - ypredicted ).  Model residuals from regression models are automatically calculated for }
\ql{\f0\fs24\cf0\up0\dn0 graphical and statistical analysis.  Residuals are stored in variables called G1_Resids, G2_Resids and }
\ql{\f0\fs24\cf0\up0\dn0 SG_Resids corresponding to Group One, Group Two or Single Group models.  The values stored in these }
\ql{\f0\fs24\cf0\up0\dn0 variables always correspond to the last model run.  Residual variables can be graphed or modeled like any }
\ql{\f0\fs24\cf0\up0\dn0 other variable.}{
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Model_Parameters}
${\footnote Model Parameters and Statistics}
K{\footnote Model Parameters and Statistics}
+{\footnote Browse:0090}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Model Parameters and Statistics}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Model parameters and statistics are displayed in the Value Window as soon as they are calculated.  This }
\ql{\f0\fs24\cf0\up0\dn0 section defines and describes each parameter and statistic.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 Model Parameters}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 N:}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 number of observations used in the model}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Ymean:}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 mean of dependent (Y) variable.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Yint:}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 model parameter indicating the y intercept}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Xn:}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 model parameter corresponding to the nth independent variable.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 LS:}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 model parameter corresponding to the left slope of a multiple slope model}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 RS:}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 model parameter corresponding to the right slope of a multiple slope model}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Xcp:}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 model parameter indicating the x change-point of a multiple slope model}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Xcp1:}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 model parameter indicating the left x change-point of a multiple slope model}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Xcp2:}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 model parameter indicating the right x change-point of a multiple slope model}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Ycp:}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 model parameter indicating the y change-point of a multiple slope model}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 Standard Error}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The standard error of each parameter is a measure of the certainty with which a model parameter is }
\ql{\f0\fs24\cf0\up0\dn0 estimated.  Large standard errors indicate that the value of the parameter is not well known.  The standard }
\ql{\f0\fs24\cf0\up0\dn0 error of each regression parameter is displayed in parenthesis following the parameter. The standard error }
\ql{\f0\fs24\cf0\up0\dn0 is defined such that with a probability of (1-a), the true value of the parameter Ptrue will fall within the }
\ql{\f0\fs24\cf0\up0\dn0 bounds:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Ptrue = Pestimated + t(1-a/2,n-p) x Standard Error(P)}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Where t is the t statistic, n is the number of observations in the data set, and p is the number of regression }
\ql{\f0\fs24\cf0\up0\dn0 parameters in the model.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 Standard Deviation}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Standard deviation is a measure of the scatter of data around its mean.  Data that are tightly packed around }
\ql{\f0\fs24\cf0\up0\dn0 the mean will have a small standard deviation.  The standard deviation is defined as:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 StdDev = [(Sum(y - y}{\f0\fs24\cf0\dn7 mean}{\f0\fs24\cf0\up0\dn0 )}{\f0\fs24\cf0\up7 2}{\f0\fs24\cf0\up0\dn0  ) / (n-1)]}{\f0\fs24\cf0\up7 1/2}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where y is an individual observation in the data set,  y}{\f0\fs24\cf0\dn7 mean}{\f0\fs24\cf0\up0\dn0  is the mean of the data set, and n is the number }
\ql{\f0\fs24\cf0\up0\dn0 of observations in the data set.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 Coefficient of Variation of the Standard Deviation}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The coefficient of variation of the standard deviation, CV-StdDev, is a dimensionless measure of the scatter }
\ql{\f0\fs24\cf0\up0\dn0 of the data around its mean formed by dividing the standard deviation by the mean.  Energy Explorer }
\ql{\f0\fs24\cf0\up0\dn0 expresses CV-StdDev as a percent.  The CV-StdDev is defined as:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 CV-StdDev = (StdDev /  y}{\f0\fs24\cf0\dn7 mean}{\f0\fs24\cf0\up0\dn0 ) x 100}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 Coefficient of Multiple Determination}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The coefficient of multiple determination, R}{\f0\fs24\cf0\up7 2}{\f0\fs24\cf0\up0\dn0 , indicates how well the data is described by the model. R}{\f0\fs24\cf0\up7 2}{\f0\fs24\cf0\up0\dn0  = }
\ql{\f0\fs24\cf0\up0\dn0 1.0 implies a perfect correlation between the data and model.  R}{\f0\fs24\cf0\up7 2}{\f0\fs24\cf0\up0\dn0  = 0.0 implies no correlation between the }
\ql{\f0\fs24\cf0\up0\dn0 data and the model.  R}{\f0\fs24\cf0\up7 2}{\f0\fs24\cf0\up0\dn0  is defined as:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0  }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0  R}{\f0\fs24\cf0\up7 2}{\f0\fs24\cf0\up0\dn0  = 1 - [ (Sum(y - y}{\f0\fs24\cf0\dn7 pred}{\f0\fs24\cf0\up0\dn0 )}{\f0\fs24\cf0\up7 2}{\f0\fs24\cf0\up0\dn0  ) / (Sum(y - y}{\f0\fs24\cf0\dn7 mean}{\f0\fs24\cf0\up0\dn0 )}{\f0\fs24\cf0\up7 2}{\f0\fs24\cf0\up0\dn0  ) ]}{
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where y}{\f0\fs24\cf0\dn7 pred}{\f0\fs24\cf0\up0\dn0  is the value of y predicted by the model.}{
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 Root Mean Square Error}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The root mean square error, RMSE, is a measure of the deviation of the data from the model.  The root }
\ql{\f0\fs24\cf0\up0\dn0 mean square error is defined as:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0  }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 RMSE = [ (Sum(y - y}{\f0\fs24\cf0\dn7 pred}{\f0\fs24\cf0\up0\dn0 )}{\f0\fs24\cf0\up7 2}{\f0\fs24\cf0\up0\dn0  ) / (n-p) ]}{\f0\fs24\cf0\up7 1/2}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where p is the number of regression coefficients in the model.}{\f0\fs24\cf0\up0\dn0\tab}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 Coefficient of Variation of the Root Mean Square Error}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Coefficient of variation of the root mean square error, CV-RMSE, is a non-dimensional measure of the }
\ql{\f0\fs24\cf0\up0\dn0 deviation of the data from the model formed by dividing a model's RMSE by the mean of the data.  The }
\ql{\f0\fs24\cf0\up0\dn0 coefficient of variation of the root mean square error is defined as:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 CV-RMSE = (RMSE /  y}{\f0\fs24\cf0\dn7 mean}{\f0\fs24\cf0\up0\dn0 ) x 100}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Measuring_Retrofit}
${\footnote Measuring Retrofit Savings}
K{\footnote Measuring Retrofit Savings}
+{\footnote Browse:0105}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Measuring Retrofit Savings}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To measure retrofit savings:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 The data set must include energy use data from both the pre and post-retrofit periods.  The data set }
\ql{\f0\fs24\cf0\up0\dn0 should also include other variables that are thought to influence energy use.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 The data should be grouped into pre and post-retrofit groups (See "Grouping Data" in Chapter 5).}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Use Energy Explorer' graphing and modeling features to generate models of pre-retrofit energy use.  }
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 If pre-retrofit energy consumption is not correlated with any influential variables in the data set, then use a }
\ql{\f0\fs24\cf0\up0\dn0 mean model.  If the data is correlated with influential variables, such as outdoor air temperature or }
\ql{\f0\fs24\cf0\up0\dn0 occupancy, then create a regression model that captures this dependency.  Use your judgment to only }
\ql{\f0\fs24\cf0\up0\dn0 include independent variables that are known to influence energy consumption. The accuracy of the }
\ql{\f0\fs24\cf0\up0\dn0 estimate of retrofit savings depends directly on the accuracy of the pre-retrofit model.  Thus, experiment }
\ql{\f0\fs24\cf0\up0\dn0 until you find a pre-retrofit model that is based on variables that influence energy use and has as low of CV-}
\ql{\f0\fs24\cf0\up0\dn0 RMSE as possible. }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 4)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select the menu items Savings, Calculate Savings.  The model's estimate of unretrofitted energy use }
\ql{\f0\fs24\cf0\up0\dn0 during the post-retrofit period, the measured post-retrofit energy use, and the savings will be displayed in }
\ql{\f0\fs24\cf0\up0\dn0 the Value Window.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Savings_Measurement}
${\footnote Savings Measurement Algorithms}
K{\footnote Savings Measurement Algorithms}
+{\footnote Browse:0110}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Savings Measurement Algorithms}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Savings are calculated as the difference between the post-retrofit energy consumption predicted by the pre-}
\ql{\f0\fs24\cf0\up0\dn0 retrofit model, Epre,  and the measured energy consumption during the post-retrofit period, Emeas.  The }
\ql{\f0\fs24\cf0\up0\dn0 procedure to calculate savings is summarized as:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Esave = Sum [ Epre  - Epost] over m data observations in the post-retrofit period.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The uncertainty of the estimate of savings depends on the accuracy of the pre-retrofit model's prediction of }
\ql{\f0\fs24\cf0\up0\dn0 energy use epre and the error associated with measuring the post-retrofit energy consumption emeas.  The }
\ql{\f0\fs24\cf0\up0\dn0 uncertainty of the model's prediction of energy use is estimated as:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 e}{\f0\fs24\cf0\dn7 pre}{\f0\fs24\cf0\up0\dn0  = 1.96 RMSE (m (1 + 2/n))}{\f0\fs24\cf0\up7 1/2}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 where RMSE is the root mean square error of the pre-retrofit model, m is the number of post-retrofit }
\ql{\f0\fs24\cf0\up0\dn0 observations and n is the number of pre-retrofit observations in the data set.  }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 By default, Energy Explorer assumes a measurement error of 2% of the measured energy consumption.  }
\ql{\f0\fs24\cf0\up0\dn0 The measurement error can be changed by selecting the menu items Savings, Define Measurement Error. }
\ql{\f0\fs24\cf0\up0\dn0 The total measurement error is estimated as: }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 e}{\f0\fs24\cf0\dn7 meas}{\f0\fs24\cf0\up0\dn0  = (percent error)  }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Assuming that the predicition and uncertainty errors are independent, the uncertainty of savings is }
\ql{\f0\fs24\cf0\up0\dn0 estimated as:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 e}{\f0\fs24\cf0\dn7 save}{\f0\fs24\cf0\up0\dn0  = (e}{\f0\fs24\cf0\dn7 pre}{\f0\fs24\cf0\up7 2}{\f0\fs24\cf0\up0\dn0  + e}{\f0\fs24\cf0\dn7 meas}{\f0\fs24\cf0\up7 2}{\f0\fs24\cf0\up0\dn0 )}{\f0\fs24\cf0\up7 1/2}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
