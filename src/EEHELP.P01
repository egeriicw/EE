#{\footnote Hlp_Data_Menu}
${\footnote Data Menu}
K{\footnote Data Menu}
+{\footnote Browse:0050}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Data Menu}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 When data is uploaded or read into Energy Explorer from a source database or file, it is stored as the active }
\ql{\f0\fs24\cf0\up0\dn0 data set in the computer's RAM memory.  Changing the data in the active data set does not change the }
\ql{\f0\fs24\cf0\up0\dn0 data in the source database or data file.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Naming Variables}{\v Hlp_Naming_Variables}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Setting No-Data Flags}{\v Hlp_Setting_NoxData}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Creating Sub-Sets of the Data}{\v Hlp_Creating_SubxSets}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Displaying The Date/Times Of The Data Set}{\v Hlp_Displaying_The}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Modifying Data Values}{\v Hlp_Modifying_Data}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Creating New Variables}{\v Hlp_Creating_New}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Deleting a Variable}{\v Hlp_Deleting_a}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Grouping Data}{\v Hlp_Grouping_Data}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Changing Time Scales}{\v Hlp_Changing_Time}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Averaging Intermittent Data}{\v Hlp_Averaging_Intermittent}  }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Naming_Variables}
${\footnote Naming Variables}
K{\footnote Naming Variables}
+{\footnote Browse:0055}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Naming Variables}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0      At any time during an Energy Explorer work session, the Define Variables box can be called by selecting }
\ql{\f0\fs24\cf0\up0\dn0 Data, Name Variables from the menu.  In the Define Variable Names dialog box, you can change the }
\ql{\f0\fs24\cf0\up0\dn0 variable names, use the variable names listed in a separate file, save the current variable names in a }
\ql{\f0\fs24\cf0\up0\dn0 separate file for later use and change the no-data flag. }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To change a variable name:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click on the variable from the Current Name box that you wish to change.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Enter a new name in the New Name text box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the Change button to lock in the new name.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 4)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Repeat this sequence to change other variable names.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 5)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the Load Names obutton to load the names without saving them, or the Save and Load Names }
\ql{\f0\fs24\cf0\up0\dn0 button to save the names in a data file, preferably with the same name as the data file except with the }
\ql{\f0\fs24\cf0\up0\dn0 filename extension ".var",  for future use before loading.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To save the current variable names in a separate file:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the Save and Load Names button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Enter a file name, preferably the same name as the data file except with the filename extension }
\ql{\f0\fs24\cf0\up0\dn0 ".var", in the File Save As dialog box that appears.}{
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Setting_NoxData}
${\footnote Setting No-Data Flags}
K{\footnote Setting No-Data Flags}
+{\footnote Browse:0060}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Setting No-Data Flags}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Energy Explorer can read data from ASCII data files. When a data element is missing or unavailable, a }
\ql{\f0\fs24\cf0\up0\dn0 numeric no-data flag such as -99 should be inserted in its place to ensure that each row of data has the }
\ql{\f0\fs24\cf0\up0\dn0 same number of data elements.  Energy Explorer's default no-data flag is -99 for ASCII data files and -9.99 }
\ql{\f0\fs24\cf0\up0\dn0 for Enertel database; however, any numeric value can be defined by selecting the menu items Data, Set }
\ql{\f0\fs24\cf0\up0\dn0 No-Data Flag.  You can also change the no-data flag in the Define Variable Names dialog box as described }
\ql{\f0\fs24\cf0\up0\dn0 in the previous sub-section.   }{
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Creating_SubxSets}
${\footnote Creating Sub-Sets of the Data}
K{\footnote Creating Sub-Sets of the Data}
+{\footnote Browse:0065}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Creating Sub-Sets of the Data}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 If the conventions described above for naming date and time variables are followed, any subset of the data }
\ql{\f0\fs24\cf0\up0\dn0 can be created by selecting Data, Select Dates from the menu.  The Select Dates dialog box will appear.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To specify new starting and ending dates:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Enter the new starting and ending dates in the Start Date and End Date text boxes using the format }
\ql{\f0\fs24\cf0\up0\dn0 described in the text box near the top of the dialog box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To remove data corresponding to specified dates: }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Enter the start-date/time and end-date/time for the block of data to be removed in the Delete From: }
\ql{\f0\fs24\cf0\up0\dn0 and Delete To: text boxes.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the Set button to lock in this choice.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)   Repeat this procedure to remove another block of data.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 When specifying dates, be sure to use the format described in the text box near the top of the dialog box.  }
\ql{\f0\fs24\cf0\up0\dn0 End the select dates procedure by selecting the OK button.  Data removed using the Select Dates dialog }
\ql{\f0\fs24\cf0\up0\dn0 box cannot be restored to the active data set without re-uploading or re-opening data from a source }
\ql{\f0\fs24\cf0\up0\dn0 database of data file. }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Displaying_The}
${\footnote Displaying The Date/Times Of The Data Set}
K{\footnote Displaying The Date/Times Of The Data Set}
+{\footnote Browse:0070}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Displaying The Date/Times Of The Data Set}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The start-date and end-date of the data set, the grouping of the data, and any blocks of data that were }
\ql{\f0\fs24\cf0\up0\dn0 removed can be displayed in the Value Window at any time during the work session.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To see the date/times of the current data set:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select Data, View Dates from the menu.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Modifying_Data}
${\footnote Modifying Data Values}
K{\footnote Modifying Data Values}
+{\footnote Browse:0075}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Modifying Data Values}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0      Data values can be modified by selecting Data, Modify Variable from the menu.  Use this function to }
\ql{\f0\fs24\cf0\up0\dn0 change units or rescale data.  The Modify Variable dialog box will appear.  Energy Explorer's built-in }
\ql{\f0\fs24\cf0\up0\dn0 functions are listed in Table 5.1.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\b\f0\fs24\cf0\up0\dn0 Table 5.1.  Built-in functions in the Data, Modify Variable procedure.}{
\par}\pard
\ql\li0\fi0\ri100{\ul\f0\fs24\cf0\up0\dn0 Function Name}{\f0\fs24\cf0\up0\dn0\tab}{\ul\f0\fs24\cf0\up0\dn0 Action}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 F to C}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Converts degrees Fahrenheit to degrees Celsius}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 C to F}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Converts degrees Celsius to degrees Fahrenheit}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 ( ) ^ constant}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Returns the constant-power}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 ( ) + constant}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Adds a constant}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 ( ) - constant}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Subtracts a constant}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 ( ) * constant}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Multiplies by a constant }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 ( ) \\ constant}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Divides by a constant}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Abs ( )}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Returns the absolute value}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 ln ( )}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Returns the natural logarithm}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Exp( )}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Returns the exponential}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Sin( )}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Returns the Sine of a variable in radians}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Cos( )}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Returns the Cosine of a variable in radians}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Degs to Rads}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Converts degrees to radians}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Rads to Degs}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Converts radians to degrees}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 MBtu to kWh}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Converts Million Btu's to Kilowatts}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Kwh to Mbtu}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Converts Kilowatts to Million Btu's}{
\par}\pard
\ql\li0\fi0\ri100{\b\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To use built-in functions:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the appropriate variable name in the Variable Name box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click on the appropriate function.  If the function chosen requires a constant, a Constant text box will }
\ql{\f0\fs24\cf0\up0\dn0 appear to the right of the Modify By: box .  Enter the value of the constant in the text box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the Set button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 4)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 When all variables have been modified, click the OK button to end the Modify Values procedure.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 No-data flags are not affected by the Data, Modify Variable procedure.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Creating_New}
${\footnote Creating New Variables}
K{\footnote Creating New Variables}
+{\footnote Browse:0080}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Creating New Variables}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0      New variables can be created in the active data set by selecting Data, Create Variable from the menu.  }
\ql{\f0\fs24\cf0\up0\dn0 The Create A New Variable Box dialog box will appear.  A new variable can be i) a duplicate of a current }
\ql{\f0\fs24\cf0\up0\dn0 variable or ii) the product, quotient, sum or difference of two current variables.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To create a duplicate variable:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Type a name in the New Variable Name box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click on a current variable in the Current Variables box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)  }{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click on the OK button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To create a new variable:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Type a name in the New Variable Name box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click on a current variable in the Current Variables box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click on an operator from the Operators box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 4)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click on another variable in the Current Variables box.  The resulting equation will be displayed in the }
\ql{\f0\fs24\cf0\up0\dn0 Equation box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 5)  Click on the OK button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The new variable's value will be no-data flag if either of it's parent's values were no-data flag.  Almost any }
\ql{\f0\fs24\cf0\up0\dn0 new variable may be created by iterative use of the Data, Modify Variable and Data, Create Variable }
\ql{\f0\fs24\cf0\up0\dn0 procedures.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Deleting_a}
${\footnote Deleting a Variable}
K{\footnote Deleting a Variable}
+{\footnote Browse:0085}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Deleting a Variable}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Variables can be deleted from the active work set by selecting the menu items, Data, Delete Variable.  In }
\ql{\f0\fs24\cf0\up0\dn0 the Delete Variables dialog box, select the variable to be deleted then click the Delete button.}{
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Grouping_Data}
${\footnote Grouping Data}
K{\footnote Grouping Data}
+{\footnote Browse:0090}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Grouping Data}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 One of Energy Explorer's most useful features is its ability to group data.  Once a the data has been divided }
\ql{\f0\fs24\cf0\up0\dn0 into groups using the following procedure, all graphs will display each group in a different color for easy }
\ql{\f0\fs24\cf0\up0\dn0 identification.  In addition, the first time a model is selected, the model will only use data from the first group. }
\ql{\f0\fs24\cf0\up0\dn0  The second time a model is selected, the model will only use data from the second group.  In this way, }
\ql{\f0\fs24\cf0\up0\dn0 individual models can be generated from each group.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Data can be grouped by date and time for time-series based grouping or by the day of week to analyze }
\ql{\f0\fs24\cf0\up0\dn0 weekday and weekend differences.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To group by date:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)  }{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select Data, Group by Date from the menu.  The dialog box Group by Date will appear.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Enter the starting and/or ending dates for Group 1 in the Start Date and End Date text boxes using }
\ql{\f0\fs24\cf0\up0\dn0 the format described in the text box near the top of the dialog box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Enter new names in the Group Names text boxes if desired.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 4)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click on the OK button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 5)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 To cause graphs to show each group in a different color and models to apply to a single group only, }
\ql{\f0\fs24\cf0\up0\dn0 click the G1G2 button in the lower right corner of the Energy Explorer work screen.  To graph and model all }
\ql{\f0\fs24\cf0\up0\dn0 data as a single group,  click the Single Group button in the lower right corner of the Energy Explorer work }
\ql{\f0\fs24\cf0\up0\dn0 screen. }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0  To group by day of week:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select Data, Group by DOW from the menu.  The data will automatically be grouped into weekday }
\ql{\f0\fs24\cf0\up0\dn0 and weekend groups. }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 To cause graphs to show each group in a different color and models to apply to a single group only, }
\ql{\f0\fs24\cf0\up0\dn0 click the G1G2 button in the lower right corner of the Energy Explorer work screen.  To graph and model all }
\ql{\f0\fs24\cf0\up0\dn0 data as a single group,  click the Single Group button in the lower right corner of the Energy Explorer work }
\ql{\f0\fs24\cf0\up0\dn0 screen.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Changing_Time}
${\footnote Changing Time Scales}
K{\footnote Changing Time Scales}
+{\footnote Browse:0095}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Changing Time Scales}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Another powerful data processing feature of Energy Explorer is its ability to change the timescale of the }
\ql{\f0\fs24\cf0\up0\dn0 data.  For example, if the active data set originally contains hourly data, the user can integrate up to the }
\ql{\f0\fs24\cf0\up0\dn0 monthly or yearly timescale.  Data can be switched back to the original timescale at any time during the }
\ql{\f0\fs24\cf0\up0\dn0 work session.  }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To change the timescale of the data: }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1.}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select the menu items, Data, Timescales\'85  I}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2.}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 In the Timescale Options dialog box, consider which variables should be summed and which should }
\ql{\f0\fs24\cf0\up0\dn0 be averaged.  For example, it may be appropriate to find the sum of energy use data over the new time }
\ql{\f0\fs24\cf0\up0\dn0 interval; whereas temperature data should be averaged since the total temperature is not meaningful.  }
\ql{\f0\fs24\cf0\up0\dn0 Select the variables to be averaged and push the right pointing arrow to move them into the Average text }
\ql{\f0\fs24\cf0\up0\dn0 box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3.}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Next consider how to handle no-data flags.  For example, some data channels in an hourly data set }
\ql{\f0\fs24\cf0\up0\dn0 may contain no-data flags.  When changing to a daily timescale, you may 1) set the value of the daily record }
\ql{\f0\fs24\cf0\up0\dn0 which contains the no-data flag equal to no-data flag, or 2) set the value of the daily record to the average or }
\ql{\f0\fs24\cf0\up0\dn0 sum of the remaining hours in the day.  Specify, how to handle no-data flags by clicking either:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 -If NoData then set Avg/Total to NoData, or}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 -If NoData then calculate Avg/Total using available data.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Averaging_Intermittent}
${\footnote Averaging Intermittent Data}
K{\footnote Averaging Intermittent Data}
+{\footnote Browse:0100}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Averaging Intermittent Data}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Some data sets may contain data recorded at uneven intervals.  To find the time average, select the menu }
\ql{\f0\fs24\cf0\up0\dn0 items Data, Average Intermittent Data\'85.}{
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_Graphical_Analysis}
${\footnote Graphical Analysis}
K{\footnote Graphical Analysis}
+{\footnote Browse:0105}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Graphical Analysis}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Time-series graphs,  XY graphs and histograms are the foundation of graphical data analysis.  Use time-}
\ql{\f0\fs24\cf0\up0\dn0 series graphs to see how a variable changes over time.  Use XY graphs to examine the relationships }
\ql{\f0\fs24\cf0\up0\dn0 between variables.  Animated XY graphs show how the relationship between two variables changes over }
\ql{\f0\fs24\cf0\up0\dn0 time.  Histograms describe the frequency distribution of a variable.  }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 These links describe Energy Explorer' graphing features.  In general, graphing is accomplished by selecting }
\ql{\f0\fs24\cf0\up0\dn0 channels in the Y Variable and X Variable list boxes and then clicking on the desired graph button.  }
\ql{\f0\fs24\cf0\up0\dn0 Additional graphing features can be accessed under the Graphics menu item.  These links describes both }
\ql{\f0\fs24\cf0\up0\dn0 the use of the graph buttons and the Graphics menu items. }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Time-Series Graphs}{\v Hlp_TimexSeries_Graphs}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb XY Graphs}{\v Hlp_XY_Graphs}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Animated XY Graphs}{\v Hlp_Animated_XY}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Histograms}{\v Hlp_Histograms}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Value Identification}{\v Hlp_Value_Identification}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 {\uldb Grid Lines}{\v Hlp_Grid_Lines}}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_TimexSeries_Graphs}
${\footnote Time-Series Graphs}
K{\footnote Time-Series Graphs}
+{\footnote Browse:0005}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Time-Series Graphs}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 Energy Explorer provides time series graphs with both zoom and overlay capabilities.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To view a time-series graph of a variable:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)  }{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select the variable to be displayed from the Y Variable list box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the Time Series button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To view a second time-series trace on the same graph:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)   }{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select the second variable to be displayed from the Y Variable list box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the 2 button.  This variable's name and scale are displayed on the right side of the graph }
\ql{\f0\fs24\cf0\up0\dn0 window.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To view subsequent time-series traces on the same graph:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)  }{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select the variable to be displayed from the Y Variable list box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the 2 button.  Note: the scale at the right of the graph window will reflect only the most recently }
\ql{\f0\fs24\cf0\up0\dn0 selected variable.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To view two time-series traces with equal Y-scales:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)  }{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select the Graphics, Single Scale from the menu.  A check mark will appear next to the Graphics, }
\ql{\f0\fs24\cf0\up0\dn0 Single Scale menu item indicating that single scale mode is active.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)  }{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 If not previously selected and displayed, select the first variable to be displayed from the Y Variable }
\ql{\f0\fs24\cf0\up0\dn0 box and click the Time Series button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)  }{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select the second variable to be displayed from the Y Variable box.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 4)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Click the 2 button.  The first and second time series traces will be re-drawn with equal y-scales.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 5)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select the Graphics, Single Scale from the menu to de-activate single scale mode.  The check mark }
\ql{\f0\fs24\cf0\up0\dn0 next to the Graphics, Single Scale menu item will disappear.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To zoom in on a portion of a time-series graph:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select Graphics, Zoom In from the menu.  A check mark will appear next to the Graphics, Zoom In }
\ql{\f0\fs24\cf0\up0\dn0 menu item, the check mark next to  the Graphics, Point menu item will disappear and the pointer will change }
\ql{\f0\fs24\cf0\up0\dn0 to a cross-hair in the graph window.  The check-mark next to Graphics, Zoom In and cross-hair pointer }
\ql{\f0\fs24\cf0\up0\dn0 indicate that Energy Explorer is in zoom-mode.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Drag over the date/times to be viewed with the mouse.  The "zoomed" view will be displayed. }{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select Graphics, Point  from the menu to return to point-mode.  The check mark next to the Graphics, }
\ql{\f0\fs24\cf0\up0\dn0 Zoom In menu item will disappear and the cross-hair will return to a pointer.  In zoom-mode, the graph can }
\ql{\f0\fs24\cf0\up0\dn0 be repeatedly enlarged by zooming.  In point-mode, individual data points can be identified  by simply }
\ql{\f0\fs24\cf0\up0\dn0 clicking on the data points.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To return to a time-series view of the entire data set.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 Select Graphics, Zoom Out from the menu.  A full data-set, time series graph of the variable currently }
\ql{\f0\fs24\cf0\up0\dn0 selected in the Y-Variable box will be displayed.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2)}{\f0\fs24\cf0\up0\dn0\tab}{\f0\fs24\cf0\up0\dn0 To return to point mode, you must select Graphics, Point if you were in zoom in mode.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
\page
#{\footnote Hlp_XY_Graphs}
${\footnote XY Graphs}
K{\footnote XY Graphs}
+{\footnote Browse:0010}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 XY Graphs}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To view a XY graph of two variables:}{
