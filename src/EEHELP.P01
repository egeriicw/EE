#{\footnote Hlp_Saving_Data1}
${\footnote Saving Data}
K{\footnote Saving Data}
+{\footnote Browse:0030}

\ql\li0\fi0\ri100{\f0\fs48\cf1\up0\dn0 Saving Data}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 To save a data file for future analysis:}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 1.  Select File, Save Data from the menu.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 2.  The Save As dialog box will appear.  Enter a new name in the text box or select the appropriate path and }
\ql{\f0\fs24\cf0\up0\dn0 file name to replace.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 3.  Click the OK button.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
