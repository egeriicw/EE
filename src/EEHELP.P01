\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0 The output will be sent to the printer configured in Windows.}{
\par}\pard
\ql\li0\fi0\ri100{\f0\fs24\cf0\up0\dn0
\par}\pard
\ql{\f0\fs24\cf0\up0\dn0
\par}\pard
